# Copy to .env and fill in. Never commit the real file.
# Sign-in secrets arrive in step 2; the names are reserved now so deployments can plan for them.

# Path to mycelium.toml (optional; defaults are used without it)
MYCELIUM_CONFIG=/config/mycelium.toml
# Overrides [vault].root
MYCELIUM_VAULT=/vault

# Generated with `mycelium hash-password` (step 2)
MYCELIUM_PASSWORD_HASH=change-me
# Base32 secret for the authenticator app (step 2)
MYCELIUM_TOTP_SECRET=change-me
# Random string of at least 32 characters that signs session cookies (step 2)
MYCELIUM_SESSION_KEY=change-me
