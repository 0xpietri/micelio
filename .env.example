# Copy to .env and fill in. Never commit the real file.
# Sign-in needs all three secrets below unless auth.mode = "none", or unless Mycelium only
# listens on localhost and none of them are set (then sign-in is off).

# Path to mycelium.toml (optional; defaults are used without it)
MYCELIUM_CONFIG=/config/mycelium.toml
# Overrides [vault].root
MYCELIUM_VAULT=/vault
# Overrides [data].dir (sign-in sessions; safe to delete, everyone just signs in again)
MYCELIUM_DATA=/data

# From `mycelium user set-password`. Keep the single quotes: the hash contains `$`.
MYCELIUM_PASSWORD_HASH='change-me'
# From `mycelium user totp`, which also shows the QR code for your authenticator app
MYCELIUM_TOTP_SECRET='change-me'
# From `mycelium user session-key` (32+ random characters)
MYCELIUM_SESSION_KEY='change-me'
