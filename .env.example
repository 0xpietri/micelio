# Copy to .env and fill in. Never commit the real file.
# Sign-in needs all three secrets below unless auth.mode = "none", or unless Micelio only
# listens on localhost and none of them are set (then sign-in is off).

# Path to micelio.toml (optional; defaults are used without it)
MICELIO_CONFIG=/config/micelio.toml
# Overrides [vault].root
MICELIO_VAULT=/vault
# Overrides [data].dir (sign-in sessions; safe to delete, everyone just signs in again)
MICELIO_DATA=/data

# From `micelio user set-password`. Keep the single quotes: the hash contains `$`.
MICELIO_PASSWORD_HASH='change-me'
# From `micelio user totp`, which also shows the QR code for your authenticator app
MICELIO_TOTP_SECRET='change-me'
# From `micelio user session-key` (32+ random characters)
MICELIO_SESSION_KEY='change-me'
